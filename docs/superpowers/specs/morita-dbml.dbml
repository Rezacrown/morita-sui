Table gamedevs {
  id serial PK
  sui_address varchar(200) UK
  email varchar(255)
  name varchar(255)
  created_at timestamp [default: `now()`]
}

Table publishers {
  id serial PK
  sui_publisher_id varchar(200) UK
  dev_id integer FK >- gamedevs.id
  name varchar(255)
  logo_url varchar(500)
  is_verified boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table games {
  id serial PK
  sui_game_id varchar(200) UK
  publisher_id integer FK >- publishers.id
  name varchar(255)
  description text
  genre varchar(100)
  website_url varchar(500)
  status varchar(20) [default: 'draft']
  game_capability_id varchar(200)
  created_at timestamp [default: `now()`]
}

Table user_kiosks {
  id serial PK
  sui_address varchar(200) UK
  kiosk_id varchar(200) UK
  kiosk_owner_cap_id varchar(200)
  created_at timestamp [default: `now()`]
}

Table api_keys {
  id serial PK
  game_id integer FK >- games.id
  key_hash varchar(255) UK
  key_prefix varchar(20)
  is_active boolean [default: true]
  last_used_at timestamp
  created_at timestamp [default: `now()`]
}

Table item_templates {
  id serial PK
  game_id integer FK >- games.id
  sui_item_id varchar(200)
  name varchar(255)
  item_type varchar(100)
  rarity varchar(100)
  description text
  image_blob_id varchar(200)
  metadata_blob_id varchar(200)
  supply integer [default: 1]
  is_nft boolean [default: true]
  attributes jsonb
  status varchar(20) [default: 'draft']
  created_at timestamp [default: `now()`]
}

Table claim_codes {
  id serial PK
  code varchar(50) UK
  game_id integer FK >- games.id
  item_template_id integer FK >- item_templates.id
  recipient_identifier varchar(255)
  expires_at timestamp
  claimed_at timestamp
  claimed_by varchar(200)
  created_at timestamp [default: `now()`]
}

Table escrow_index {
  id serial PK
  escrow_id varchar(200) UK
  initiator_address varchar(200)
  offer_game_id integer FK >- games.id
  offer_item_blob_id varchar(200)
  conditions_json jsonb
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  fulfilled_at timestamp
  cancelled_at timestamp
}

Table item_cache {
  id serial PK
  blob_id varchar(200) UK
  game_id integer FK >- games.id
  name varchar(255)
  description text
  image_blob_id varchar(200)
  tags jsonb
  attributes jsonb
  created_at timestamp [default: `now()`]
}

Table tx_events {
  id serial PK
  tx_hash varchar(200)
  event_type varchar(100)
  game_id integer FK >- games.id
  from_address varchar(200)
  to_address varchar(200)
  item_blob_id varchar(200)
  metadata jsonb
  created_at timestamp [default: `now()`]
}

Ref: gamedevs.id < publishers.devId
Ref: publishers.id < games.publisherId
Ref: games.id < itemTemplates.gameId
Ref: games.id < claimCodes.gameId
Ref: games.id < apiKeys.gameId
Ref: games.id < escrowIndex.offerGameId
Ref: games.id < itemCache.gameId
Ref: games.id < txEvents.gameId
Ref: itemTemplates.id < claimCodes.itemTemplateId
